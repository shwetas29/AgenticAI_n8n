      "parameters": {
        "jsCode": "const intake = $input.first().json.intake || $input.first().json;\nif (!intake.reportId) throw new Error('intake.reportId required');\nreturn [{ json: {\n  reportId: intake.reportId,\n  intake,\n  decisionLog: [{ ts: new Date().toISOString(), stage: 'start', reportId: intake.reportId }],\n  frameworkVersion: $env.FRAMEWORK_VERSION || '1.0.0'\n}}];"
