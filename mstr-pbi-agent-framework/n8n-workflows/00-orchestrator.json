        "jsCode": "const bundle = $('Init Bundle').first().json;\nconst discovery = $input.first().json.result || $input.first().json;\nbundle.inventory = discovery;\nbundle.decisionLog.push({ ts: new Date().toISOString(), stage: 'discover', reportId: bundle.reportId });\nreturn [{ json: bundle }];"
