    {
      "parameters": {
        "jsCode": "const bundle = $('Merge Classification').first().json;\nconst approval = $input.first().json;\nbundle.approvals = {\n  approved: approval.approved !== false,\n  approver: approval.approver || 'unknown',\n  notes: approval.notes || '',\n  ts: new Date().toISOString()\n};\nif (bundle.approvals.approved === false) {\n  bundle.halted = true;\n  bundle.haltReason = 'Rejected at HITL';\n}\nbundle.decisionLog.push({ ts: new Date().toISOString(), stage: 'hitl', reportId: bundle.reportId, approved: bundle.approvals.approved });\nreturn [{ json: bundle }];"
      },
