{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://migration.local/schemas/report-intake.schema.json",
  "title": "ReportIntake",
  "type": "object",
  "required": ["reportId", "name", "type", "description", "sourceSystem"],
  "properties": {
    "reportId": { "type": "string", "description": "Stable GUID or estate key" },
    "name": { "type": "string" },
    "type": { "enum": ["grid", "dossier", "document", "cube", "other"] },
    "sourceSystem": { "const": "microstrategy" },
    "project": { "type": "string" },
    "folderPath": { "type": "string" },
    "description": { "type": "string" },
    "businessOwner": { "type": "string" },
    "usage": {
      "type": "object",
      "properties": {
        "monthlyActiveUsers": { "type": "number" },
        "executionsLast90Days": { "type": "number" },
        "criticality": { "enum": ["low", "medium", "high", "regulatory"] }
      }
    },
    "layout": {
      "type": "object",
      "properties": {
        "rows": { "type": "array", "items": { "type": "string" } },
        "columns": { "type": "array", "items": { "type": "string" } },
        "pages": { "type": "array", "items": { "type": "string" } },
        "visuals": { "type": "array", "items": { "type": "string" } }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "expressionHint": { "type": "string" },
          "format": { "type": "string" },
          "thresholds": { "type": "array", "items": { "type": "object" } }
        }
      }
    },
    "attributes": { "type": "array", "items": { "type": "string" } },
    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "kind": { "enum": ["prompt", "viewFilter", "securityFilter", "topN", "other"] },
          "detail": { "type": "string" }
        }
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "rlsHints": { "type": "array", "items": { "type": "string" } },
        "olsHints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "drillPaths": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "objectType": { "type": "string" },
          "name": { "type": "string" }
        }
      }
    },
    "rawMetadata": { "type": "object", "description": "Optional MSTR REST dump" }
  },
  "additionalProperties": true
}
