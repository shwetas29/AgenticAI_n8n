# Copy to n8n environment / secrets store — do not commit real values.

# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Or Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Optional MicroStrategy REST
MSTR_BASE_URL=
MSTR_USERNAME=
MSTR_PASSWORD=
MSTR_PROJECT_ID=

# Optional Power BI / Fabric
PBI_TENANT_ID=
PBI_CLIENT_ID=
PBI_CLIENT_SECRET=
PBI_WORKSPACE_ID=

# Evidence sink
EVIDENCE_SINK=n8n_data_table
# EVIDENCE_SINK=postgres
POSTGRES_CONNECTION=

# HITL
HITL_CHANNEL=slack
SLACK_WEBHOOK_URL=
APPROVER_EMAILS=bi.migration@example.com

# Framework
FRAMEWORK_VERSION=1.0.0
DEFAULT_TARGET_PLATFORM=fabric
